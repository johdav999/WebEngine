# Configure isolated consumers; reject incorrect options with the intended message.
set(common -G "${GENERATOR}" "-DWEBENGINE_SOURCE_DIR=${ENGINE_SOURCE}")
if(TOOLCHAIN)
  list(APPEND common "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
if(PLATFORM)
  list(APPEND common -A "${PLATFORM}")
endif()
function(check_config name expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${ENGINE_SOURCE}/examples/rpg"
    -B "${OUTPUT}/${name}" ${common} ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(expected STREQUAL "success")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${name} failed: ${out}\n${err}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${OUTPUT}/${name}" --config Release --parallel 2 RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${name} omitted consumer failed to build")
    endif()
    execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${OUTPUT}/${name}" -C Release --output-on-failure
      RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${name} omitted consumer failed to run")
    endif()
  elseif(result EQUAL 0 OR NOT "${out}\n${err}" MATCHES "${expected}")
    message(FATAL_ERROR "${name} did not reject as expected (${expected}): ${out}\n${err}")
  endif()
  if(EXISTS "${OUTPUT}/${name}/_deps")
    message(FATAL_ERROR "Standalone consumer created dependency download directory")
  endif()
endfunction()
if(ONLY_BRIDGE_OFF)
  check_config(bridge_off success -DWEBENGINE_BUILD_RPG=ON -DWEBENGINE_BUILD_RPG_QUESTS=OFF -DWEBENGINE_BUILD_QUESTS=OFF)
  return()
endif()
check_config(default_off success)
check_config(all_off success -DWEBENGINE_BUILD_RPG=OFF -DWEBENGINE_BUILD_MODULES=OFF)
check_config(missing_modules "WebEngine::RPG requires WebEngine::Modules" -DWEBENGINE_BUILD_RPG=ON -DWEBENGINE_BUILD_MODULES=OFF)
check_config(demo "not implemented" -DWEBENGINE_BUILD_RPG_DEMO=ON)
check_config(bridge_without_rpg "requires WEBENGINE_BUILD_RPG=ON" -DWEBENGINE_BUILD_RPG_QUESTS=ON)
check_config(bridge_without_quests "WebEngine::RPGQuests requires WebEngine::Quests" -DWEBENGINE_BUILD_RPG=ON -DWEBENGINE_BUILD_RPG_QUESTS=ON)
check_config(tests_without_library "requires WEBENGINE_BUILD_RPG=ON" -DWEBENGINE_BUILD_RPG_TESTS=ON)
