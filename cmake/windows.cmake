add_custom_command(TARGET webengine_windows POST_BUILD
  COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:webengine_windows>/assets/fonts" "$<TARGET_FILE_DIR:webengine_windows>/assets/audio"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/third_party/noto/NotoSans-Regular.ttf" "$<TARGET_FILE_DIR:webengine_windows>/assets/fonts"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/tests/fixtures/audio-tone.wav" "$<TARGET_FILE_DIR:webengine_windows>/assets/audio/preview.wav"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/tests/fixtures/static_instances.glb" "$<TARGET_FILE_DIR:webengine_windows>/assets/iteration.glb"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/assets/content-iteration.tga" "$<TARGET_FILE_DIR:webengine_windows>/assets/iteration.tga"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL3::SDL3-shared>" "$<TARGET_FILE_DIR:webengine_windows>"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/third_party/noto/NotoSans-Regular.ttf" "$<TARGET_FILE_DIR:webengine_windows>"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/third_party/noto/LICENSE" "$<TARGET_FILE_DIR:webengine_windows>/Noto-LICENSE.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${WEBENGINE_DXC_DIR}/bin/x64/dxcompiler.dll" "${WEBENGINE_DXC_DIR}/bin/x64/dxil.dll" "$<TARGET_FILE_DIR:webengine_windows>"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_deps}/Dawn-LICENSE.txt" "$<TARGET_FILE_DIR:webengine_windows>"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_deps}/sdl/SDL3-3.4.18/LICENSE.txt" "$<TARGET_FILE_DIR:webengine_windows>/SDL-LICENSE.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${WEBENGINE_DXC_DIR}/LICENCE-MIT.txt" "$<TARGET_FILE_DIR:webengine_windows>/DXC-LICENCE-MIT.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${WEBENGINE_DXC_DIR}/LICENSE-LLVM.txt" "$<TARGET_FILE_DIR:webengine_windows>/DXC-LICENSE-LLVM.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${WEBENGINE_DXC_DIR}/LICENSE-MS.txt" "$<TARGET_FILE_DIR:webengine_windows>/DXC-LICENSE-MS.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${WEBENGINE_JOLT_SOURCE_DIR}/LICENSE" "$<TARGET_FILE_DIR:webengine_windows>/Jolt-LICENSE.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/third_party/ufbx/LICENSE" "$<TARGET_FILE_DIR:webengine_windows>/ufbx-LICENSE.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/third_party/cgltf/LICENSE" "$<TARGET_FILE_DIR:webengine_windows>/cgltf-LICENSE.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/third_party/meshoptimizer/LICENSE.md" "$<TARGET_FILE_DIR:webengine_windows>/meshoptimizer-LICENSE.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_desktop_engine_root}/third_party/stb/LICENSE" "$<TARGET_FILE_DIR:webengine_windows>/stb-LICENSE.txt"
  COMMENT "Copying SDL3 runtime beside the Windows proof")
