    COMMAND ${Python3_EXECUTABLE} "${_desktop_engine_root}/tools/embed_d3d12_shaders.py" "${_d3d_shaders}" ${_d3d_binary}
    DEPENDS ${_d3d_binary} "${_desktop_engine_root}/tools/embed_d3d12_shaders.py" VERBATIM)
