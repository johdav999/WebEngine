if(NOT WIN32 OR EMSCRIPTEN OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "The Windows proof requires Windows x64 and MSVC. Use scripts/build-windows.ps1.")
endif()
get_filename_component(_desktop_engine_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
# SDKs are installed locally by setup-windows.ps1, never by normal core/browser builds.
set(_desktop_deps "${_desktop_engine_root}/build/dependencies/windows")
list(APPEND CMAKE_PREFIX_PATH
  "${_desktop_deps}/sdl/SDL3-3.4.18"
  "${_desktop_deps}/dawn/Dawn-67d4d6e64b0755d638f76549794692badfdbc8ab-windows-latest-Release")
find_package(Threads REQUIRED)
find_package(SDL3 3.4.18 CONFIG REQUIRED)
find_package(Dawn CONFIG REQUIRED)
set(WEBENGINE_DXC_DIR "${_desktop_deps}/dxc" CACHE PATH "Pinned DirectX Shader Compiler package")
if(NOT EXISTS "${WEBENGINE_DXC_DIR}/bin/x64/dxcompiler.dll")
  message(FATAL_ERROR "Dawn D3D12 needs dxcompiler.dll and dxil.dll; run scripts/setup-windows.ps1.")
endif()
include("${_desktop_engine_root}/cmake/shaders.cmake")
foreach(_target engine_core engine_gui ufbx)
  target_compile_options(${_target} PRIVATE /MP4)
endforeach()

