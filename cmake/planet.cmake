option(WEBENGINE_BUILD_PLANET "Build optional portable planetary terrain" ON)
option(WEBENGINE_BUILD_PLANET_DEMO "Build shared procedural planet flight example" OFF)
if(NOT WEBENGINE_BUILD_PLANET)
  if(WEBENGINE_BUILD_PLANET_DEMO)
    message(FATAL_ERROR "Planet demo requires WEBENGINE_BUILD_PLANET")
  endif()
  return()
endif()
add_library(engine_planet src/planet.cpp src/planet_physics.cpp)
add_library(WebEngine::Planet ALIAS engine_planet)
target_link_libraries(engine_planet PUBLIC engine_core)
if(EMSCRIPTEN)
  target_compile_options(engine_planet PRIVATE -fexceptions -Wall -Wextra -Wpedantic)
elseif(MSVC)
  target_compile_options(engine_planet PRIVATE /W4 /utf-8)
else()
  target_compile_options(engine_planet PRIVATE -Wall -Wextra -Wpedantic)
endif()
if(BUILD_TESTING OR EMSCRIPTEN)
  add_executable(planet_tests tests/planet_tests.cpp)
  target_link_libraries(planet_tests PRIVATE WebEngine::Planet)
  add_executable(planet_physics_tests tests/planet_physics_tests.cpp)
  target_link_libraries(planet_physics_tests PRIVATE WebEngine::Planet)
  if(EMSCRIPTEN)
    target_compile_options(planet_tests PRIVATE -fexceptions)
    target_link_options(planet_tests PRIVATE -fexceptions -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sENVIRONMENT=node)
    set_target_properties(planet_tests PROPERTIES SUFFIX ".js")
    target_compile_options(planet_physics_tests PRIVATE -fexceptions)
    target_link_options(planet_physics_tests PRIVATE -fexceptions -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sENVIRONMENT=node)
    set_target_properties(planet_physics_tests PROPERTIES SUFFIX ".js")
  else()
    add_test(NAME planet COMMAND planet_tests)
    add_test(NAME planet_physics COMMAND planet_physics_tests)
  endif()
endif()
if(NOT WEBENGINE_BUILD_PLANET_DEMO)
  return()
endif()
if(EMSCRIPTEN)
  add_executable(planet_demo examples/planet/browser.cpp src/renderer.cpp src/webgpu_host_browser.cpp
    src/webgpu_renderer.cpp src/webgpu_water.cpp src/webgl_renderer.cpp src/webgl_water.cpp src/gui_renderer.cpp)
  target_link_libraries(planet_demo PRIVATE WebEngine::Planet engine_gui)
  target_include_directories(planet_demo PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
  target_compile_options(planet_demo PRIVATE -fexceptions --use-port=emdawnwebgpu)
  target_link_options(planet_demo PRIVATE -fexceptions --use-port=emdawnwebgpu -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2
    -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sENVIRONMENT=web
    "-sEXPORTED_FUNCTIONS=['_main','_planet_command','_planet_input']")
  set_target_properties(planet_demo PROPERTIES SUFFIX ".js" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/planet-site")
  add_custom_command(TARGET planet_demo POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
    "${CMAKE_CURRENT_SOURCE_DIR}/examples/planet/index.html" "${CMAKE_CURRENT_BINARY_DIR}/planet-site/index.html")
elseif(TARGET WebEngine::Desktop)
  add_executable(webengine_planet_windows examples/planet/windows.cpp)
  target_link_libraries(webengine_planet_windows PRIVATE WebEngine::Planet WebEngine::Desktop SDL3::SDL3)
  target_compile_options(webengine_planet_windows PRIVATE /utf-8)
  add_custom_command(TARGET webengine_planet_windows POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:webengine_planet_windows>/assets/fonts"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_SOURCE_DIR}/third_party/noto/NotoSans-Regular.ttf" "$<TARGET_FILE_DIR:webengine_planet_windows>/assets/fonts"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL3::SDL3-shared>" "$<TARGET_FILE_DIR:webengine_planet_windows>")
endif()
