if(EMSCRIPTEN)
  add_executable(hybrid_terrain_demo examples/hybrid_terrain/browser.cpp src/renderer.cpp src/webgpu_host_browser.cpp
    src/webgpu_renderer.cpp src/webgpu_water.cpp src/webgl_renderer.cpp src/webgl_water.cpp src/gui_renderer.cpp)
  target_link_libraries(hybrid_terrain_demo PRIVATE engine_core engine_gui)
  target_include_directories(hybrid_terrain_demo PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
  target_compile_options(hybrid_terrain_demo PRIVATE -fexceptions --use-port=emdawnwebgpu)
  target_link_options(hybrid_terrain_demo PRIVATE -fexceptions --use-port=emdawnwebgpu -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2
    -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sENVIRONMENT=web
    "-sEXPORTED_FUNCTIONS=['_main','_hybrid_command','_hybrid_edit','_hybrid_probe','_hybrid_lod','_hybrid_flight']")
  set_target_properties(hybrid_terrain_demo PROPERTIES SUFFIX ".js" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/hybrid-site")
  add_custom_command(TARGET hybrid_terrain_demo POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
    "${CMAKE_CURRENT_SOURCE_DIR}/examples/hybrid_terrain/index.html" "${CMAKE_CURRENT_BINARY_DIR}/hybrid-site/index.html")
  add_custom_command(TARGET hybrid_terrain_demo POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
    "${CMAKE_CURRENT_SOURCE_DIR}/examples/hybrid_terrain/flight.js" "${CMAKE_CURRENT_BINARY_DIR}/hybrid-site/flight.js")
elseif(TARGET WebEngine::Desktop)
  add_executable(webengine_hybrid_terrain_windows examples/hybrid_terrain/windows.cpp)
  target_link_libraries(webengine_hybrid_terrain_windows PRIVATE WebEngine::Desktop SDL3::SDL3)
  target_compile_options(webengine_hybrid_terrain_windows PRIVATE /utf-8)
  add_custom_command(TARGET webengine_hybrid_terrain_windows POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:webengine_hybrid_terrain_windows>/assets/fonts"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_SOURCE_DIR}/third_party/noto/NotoSans-Regular.ttf" "$<TARGET_FILE_DIR:webengine_hybrid_terrain_windows>/assets/fonts"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL3::SDL3-shared>" "$<TARGET_FILE_DIR:webengine_hybrid_terrain_windows>")
endif()
