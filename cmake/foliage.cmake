option(WEBENGINE_BUILD_FOLIAGE "Build portable foliage placement and projection" OFF)
option(WEBENGINE_BUILD_FOLIAGE_TESTS "Build foliage contracts" OFF)
option(WEBENGINE_BUILD_FOLIAGE_DEMO "Build browser/Windows foliage example" OFF)
if(NOT WEBENGINE_BUILD_FOLIAGE)
  if(WEBENGINE_BUILD_FOLIAGE_TESTS OR WEBENGINE_BUILD_FOLIAGE_DEMO)
    message(FATAL_ERROR "Foliage tests/demo require WEBENGINE_BUILD_FOLIAGE=ON")
  endif()
  return()
endif()
add_library(engine_foliage STATIC src/foliage.cpp)
add_library(WebEngine::Foliage ALIAS engine_foliage)
target_link_libraries(engine_foliage PUBLIC engine_core)
if(EMSCRIPTEN)
  target_compile_options(engine_foliage PUBLIC -fexceptions)
  target_link_options(engine_foliage INTERFACE -fexceptions)
elseif(MSVC)
  target_compile_options(engine_foliage PRIVATE /W4 /utf-8)
else()
  target_compile_options(engine_foliage PRIVATE -Wall -Wextra -Wpedantic)
endif()
if(WEBENGINE_BUILD_FOLIAGE_TESTS)
  enable_testing()
  add_executable(foliage_tests tests/foliage_tests.cpp)
  target_link_libraries(foliage_tests PRIVATE WebEngine::Foliage)
  if(EMSCRIPTEN)
    set_target_properties(foliage_tests PROPERTIES SUFFIX ".js")
    target_link_options(foliage_tests PRIVATE -sENVIRONMENT=node,web -sEXIT_RUNTIME=1 -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576)
  endif()
  add_test(NAME foliage_contracts COMMAND ${CMAKE_CROSSCOMPILING_EMULATOR} $<TARGET_FILE:foliage_tests>)
endif()
if(WEBENGINE_BUILD_FOLIAGE_DEMO)
  if(EMSCRIPTEN)
    add_executable(foliage_demo examples/foliage/browser.cpp)
    target_link_libraries(foliage_demo PRIVATE WebEngine::Foliage WebEngine::Browser)
    target_link_options(foliage_demo PRIVATE -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sENVIRONMENT=web)
    set_target_properties(foliage_demo PROPERTIES SUFFIX ".js" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/foliage-site")
    configure_file("${CMAKE_CURRENT_SOURCE_DIR}/examples/foliage/index.html"
      "${CMAKE_CURRENT_BINARY_DIR}/foliage-site/index.html" COPYONLY)
  elseif(TARGET WebEngine::Desktop)
    add_executable(foliage_demo_windows examples/foliage/windows.cpp)
    target_link_libraries(foliage_demo_windows PRIVATE WebEngine::Foliage WebEngine::Desktop)
    target_compile_options(foliage_demo_windows PRIVATE /utf-8)
    add_custom_command(TARGET foliage_demo_windows POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:foliage_demo_windows>/assets/fonts"
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_SOURCE_DIR}/third_party/noto/NotoSans-Regular.ttf" "$<TARGET_FILE_DIR:foliage_demo_windows>/assets/fonts"
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL3::SDL3-shared>" "${WEBENGINE_DXC_DIR}/bin/x64/dxcompiler.dll" "${WEBENGINE_DXC_DIR}/bin/x64/dxil.dll" "$<TARGET_FILE_DIR:foliage_demo_windows>")
  else()
    message(FATAL_ERROR "Foliage demo requires browser or Windows host")
  endif()
endif()
