if(NOT WEBENGINE_BUILD_RPG_DEMO)
  return()
endif()
if(NOT TARGET WebEngine::RPGQuests)
  message(FATAL_ERROR "RPG demo requires RPG, Quests and WEBENGINE_BUILD_RPG_QUESTS=ON")
endif()
add_library(rpg_host_sample INTERFACE)
target_link_libraries(rpg_host_sample INTERFACE WebEngine::RPGQuests engine_ai engine_gui)
add_executable(rpg_host_tests tests/rpg_host_tests.cpp)
target_link_libraries(rpg_host_tests PRIVATE rpg_host_sample)
enable_testing()
if(EMSCRIPTEN)
  set_target_properties(rpg_host_tests PROPERTIES SUFFIX ".js")
  target_link_options(rpg_host_tests PRIVATE -fexceptions -sENVIRONMENT=node -sEXIT_RUNTIME=1 -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576)
endif()
add_test(NAME rpg_host COMMAND ${CMAKE_CROSSCOMPILING_EMULATOR} $<TARGET_FILE:rpg_host_tests>)
if(EMSCRIPTEN)
  add_executable(rpg_demo examples/rpg/browser.cpp)
  target_link_libraries(rpg_demo PRIVATE rpg_host_sample WebEngine::Browser)
  target_link_options(rpg_demo PRIVATE -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sENVIRONMENT=web)
  set_target_properties(rpg_demo PROPERTIES SUFFIX ".js" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/rpg-site")
  add_custom_command(TARGET rpg_demo POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
    "${CMAKE_CURRENT_SOURCE_DIR}/examples/rpg/index.html" "${CMAKE_CURRENT_SOURCE_DIR}/examples/rpg/host.js" "${CMAKE_CURRENT_BINARY_DIR}/rpg-site")
elseif(TARGET WebEngine::Desktop)
  add_executable(rpg_demo_windows examples/rpg/windows.cpp)
  target_link_libraries(rpg_demo_windows PRIVATE rpg_host_sample WebEngine::Desktop WebEngine::WindowsRuntime SDL3::SDL3)
  target_compile_options(rpg_demo_windows PRIVATE /utf-8)
  add_custom_command(TARGET rpg_demo_windows POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:rpg_demo_windows>/assets/fonts"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_SOURCE_DIR}/third_party/noto/NotoSans-Regular.ttf" "$<TARGET_FILE_DIR:rpg_demo_windows>/assets/fonts"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL3::SDL3-shared>" "${WEBENGINE_DXC_DIR}/bin/x64/dxcompiler.dll" "${WEBENGINE_DXC_DIR}/bin/x64/dxil.dll" "$<TARGET_FILE_DIR:rpg_demo_windows>")
else()
  message(STATUS "RPG controller tests enabled; rendered hosts require Emscripten or Windows Desktop")
endif()
