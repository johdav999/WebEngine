option(WEBENGINE_BUILD_CLOTHING "Build shared-rig character clothing" OFF)
option(WEBENGINE_BUILD_CLOTHING_TESTS "Build clothing contracts" OFF)
option(WEBENGINE_BUILD_CLOTHING_DEMO "Build clothing host example" OFF)
if(NOT WEBENGINE_BUILD_CLOTHING)
  if(WEBENGINE_BUILD_CLOTHING_TESTS OR WEBENGINE_BUILD_CLOTHING_DEMO)
    message(FATAL_ERROR "Clothing tests/demo require WEBENGINE_BUILD_CLOTHING=ON")
  endif()
  return()
endif()
add_library(engine_clothing STATIC src/clothing.cpp src/cloth.cpp src/cloth_asset.cpp)
add_library(WebEngine::Clothing ALIAS engine_clothing)
target_link_libraries(engine_clothing PUBLIC engine_core)
if(EMSCRIPTEN)
  target_compile_options(engine_clothing PUBLIC -fexceptions)
  target_link_options(engine_clothing INTERFACE -fexceptions)
endif()
if(WEBENGINE_BUILD_CLOTHING_TESTS)
  enable_testing()
  add_executable(clothing_tests tests/clothing_tests.cpp)
  target_link_libraries(clothing_tests PRIVATE WebEngine::Clothing)
  if(EMSCRIPTEN)
    set_target_properties(clothing_tests PROPERTIES SUFFIX ".js")
    target_link_options(clothing_tests PRIVATE -sENVIRONMENT=node,web -sEXIT_RUNTIME=1 -sALLOW_MEMORY_GROWTH=1)
  endif()
  add_test(NAME clothing_contracts COMMAND ${CMAKE_CROSSCOMPILING_EMULATOR} $<TARGET_FILE:clothing_tests>)
endif()
if(WEBENGINE_BUILD_CLOTHING_DEMO)
  if(EMSCRIPTEN)
    add_executable(clothing_demo examples/clothing/browser.cpp)
    target_link_libraries(clothing_demo PRIVATE WebEngine::Clothing WebEngine::Browser)
    target_link_options(clothing_demo PRIVATE -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sENVIRONMENT=web)
    set_target_properties(clothing_demo PROPERTIES SUFFIX ".js" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/clothing-site")
    add_custom_command(TARGET clothing_demo POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "${CMAKE_CURRENT_SOURCE_DIR}/examples/clothing/index.html" "${CMAKE_CURRENT_BINARY_DIR}/clothing-site/index.html")
  elseif(TARGET WebEngine::Desktop)
    add_executable(clothing_demo_windows examples/clothing/windows.cpp)
    target_link_libraries(clothing_demo_windows PRIVATE WebEngine::Clothing WebEngine::Desktop)
    target_compile_options(clothing_demo_windows PRIVATE /utf-8)
    add_custom_command(TARGET clothing_demo_windows POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:clothing_demo_windows>/assets/fonts"
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_SOURCE_DIR}/third_party/noto/NotoSans-Regular.ttf" "$<TARGET_FILE_DIR:clothing_demo_windows>/assets/fonts"
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL3::SDL3-shared>" "${WEBENGINE_DXC_DIR}/bin/x64/dxcompiler.dll" "${WEBENGINE_DXC_DIR}/bin/x64/dxil.dll" "$<TARGET_FILE_DIR:clothing_demo_windows>")
  else()
    message(FATAL_ERROR "Clothing demo requires browser or Windows host")
  endif()
endif()
