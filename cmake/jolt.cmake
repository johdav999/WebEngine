# Keep the third-party build's flags and generic option names in this scope.
function(webengine_add_jolt)
  include(FetchContent)
  if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
  endif()
  set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
  set(OVERRIDE_CXX_FLAGS OFF)
  set(INTERPROCEDURAL_OPTIMIZATION OFF)
  set(ENABLE_ALL_WARNINGS OFF)
  set(ENABLE_INSTALL OFF)
  set(GENERATE_DEBUG_SYMBOLS OFF)
  set(FLOATING_POINT_EXCEPTIONS_ENABLED OFF)
  set(CPP_EXCEPTIONS_ENABLED ON)
  set(CPP_RTTI_ENABLED ON)
  set(DEBUG_RENDERER_IN_DEBUG_AND_RELEASE OFF)
  set(PROFILER_IN_DEBUG_AND_RELEASE OFF)
  set(ENABLE_OBJECT_STREAM OFF)
  set(USE_WASM_SIMD OFF)
  set(DOUBLE_PRECISION OFF)
  set(BUILD_SHARED_LIBS OFF)
  foreach(feature SSE4_1 SSE4_2 AVX AVX2 AVX512 LZCNT TZCNT F16C FMADD)
    set(USE_${feature} OFF)
  endforeach()
  FetchContent_Declare(jolt
    URL https://codeload.github.com/jrouwe/JoltPhysics/tar.gz/refs/tags/v5.3.0
    URL_HASH SHA256=e7f9621e480646c434150e1fbe3a9410f4ec4b04ffe54791e0678326b741b918
    SOURCE_SUBDIR Build)
  FetchContent_MakeAvailable(jolt)
  set(WEBENGINE_JOLT_SOURCE_DIR "${jolt_SOURCE_DIR}" PARENT_SCOPE)
endfunction()
webengine_add_jolt()
